<div>
    {{#if isWizard}}
    <div style="padding: 10px 20px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
            <h2 style="margin: 0; border: none;"><i class="fas fa-magic" style="color: var(--aer-accent-purple);"></i> {{localize "AOE.Config.WizardTitle"}}</h2>
            <div class="aer-wizard-progress-bg">
                <div class="aer-wizard-progress-bar" style="width: 0%;"></div>
            </div>
        </div>

        <div class="aer-wizard-content">
            <!-- STEP 1 -->
            <div class="wizard-step" data-step="1">
                <h3 class="aer-step-header">{{localize "AOE.Config.Step1Title"}}</h3>
                <p class="aer-notes">{{localize "AOE.Config.Step1Notes"}}</p>
                
                <div style="display: flex; flex-direction: column; gap: 10px; margin-top: 15px;">
                    <label class="aer-radio-box">
                        <input type="radio" name="wizardShape" value="normal" {{#if provideTemplate}}checked{{/if}}>
                        <strong>{{localize "AOE.Config.ShapeNormal"}}</strong> {{localize "AOE.Config.ShapeNormalSub"}}
                    </label>
                    <label class="aer-radio-box">
                        <input type="radio" name="wizardShape" value="multi" {{#if enableMultiTarget}}checked{{/if}}>
                        <strong>{{localize "AOE.Config.ShapeMulti"}}</strong> {{localize "AOE.Config.ShapeMultiSub"}}
                    </label>
                    <label class="aer-radio-box">
                        <input type="radio" name="wizardShape" value="tactical" {{#if tacticalDrawing}}checked{{/if}}>
                        <strong>{{localize "AOE.Config.ShapeTactical"}}</strong> {{localize "AOE.Config.ShapeTacticalSub"}}
                    </label>
                </div>

                <div class="wizard-normal-settings aer-sub-settings" style="display: {{#if provideTemplate}}block{{else}}none{{/if}};">
                    <div class="form-group" style="margin-bottom: 0;">
                        <label style="font-weight: bold; flex: 0 0 120px;">{{localize "AOE.Config.ShapeSize"}}</label>
                        <div class="form-fields" style="display: flex; gap: 10px; align-items: center;">
                            <select name="flags.aoe-easy-resolve.templateType" style="flex: 2; padding: 4px;">
                                <option value="circle" {{#if isCircle}}selected{{/if}}>Burst</option>
                                <option value="cone" {{#if isCone}}selected{{/if}}>Cone</option>
                                <option value="ray" {{#if isRay}}selected{{/if}}>Line</option>
                            </select>
                            <input type="number" name="flags.aoe-easy-resolve.templateDistance" value="{{templateDistance}}" placeholder="15" style="flex: 1; text-align: center; padding: 4px;">
                            <span style="font-weight: bold; color: #555;">ft.</span>
                        </div>
                    </div>
                </div>
                <div class="wizard-tactical-settings aer-sub-settings" style="display: {{#if tacticalDrawing}}block{{else}}none{{/if}};">
                    <div class="form-group" style="margin-bottom: 0;">
                        <label style="font-weight: bold; flex: 0 0 180px;">{{localize "AOE.Config.MaxSquares"}}</label>
                        <div class="form-fields" style="display: flex; gap: 10px; align-items: center;">
                            <input type="number" name="flags.aoe-easy-resolve.tacticalBlocks" value="{{tacticalBlocks}}" placeholder="e.g. 4" style="flex: 1; text-align: center; padding: 4px;">
                        </div>
                    </div>
                </div>
            </div>

            <!-- STEP 2 -->
            <div class="wizard-step" data-step="2" style="display: none;">
                <h3 class="aer-step-header">{{localize "AOE.Config.Step2Title"}}</h3>
                <p class="aer-notes">{{localize "AOE.Config.Step2Notes"}}</p>
                
                <div style="display: flex; gap: 15px; margin-top: 15px;">
                    <label class="aer-radio-box" style="flex: 1; justify-content: center;">
                        <input type="radio" name="wizardSave" value="yes" {{#if useOverride}}checked{{/if}}> {{localize "AOE.Config.SaveYes"}}
                    </label>
                    <label class="aer-radio-box" style="flex: 1; justify-content: center;">
                        <input type="radio" name="wizardSave" value="no" {{#unless useOverride}}checked{{/unless}}> {{localize "AOE.Config.SaveNo"}}
                    </label>
                </div>

                <div class="wizard-save-settings aer-sub-settings" style="display: {{#if useOverride}}block{{else}}none{{/if}};">
                    <div class="form-group" style="margin-bottom: 10px;">
                        <label style="font-weight: bold; flex: 0 0 120px;">{{localize "AOE.Config.SaveType"}}</label>
                        <div class="form-fields">
                            <select name="flags.aoe-easy-resolve.saveType" style="padding: 4px;">
                                <option value="fortitude" {{#if isFort}}selected{{/if}}>Fortitude</option>
                                <option value="reflex" {{#if isReflex}}selected{{/if}}>Reflex</option>
                                <option value="will" {{#if isWill}}selected{{/if}}>Will</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-group" style="margin-bottom: 0;">
                        <label style="font-weight: bold; flex: 0 0 120px;">{{localize "AOE.Config.TargetDC"}}</label>
                        <div class="form-fields" style="display: flex; gap: 10px; align-items: center;">
                            <select name="flags.aoe-easy-resolve.dcType" style="flex: 2; padding: 4px;">
                                <option value="highest" {{#if isHighestDC}}selected{{/if}}>Highest of Caster</option>
                                <option value="spell" {{#if isSpellDC}}selected{{/if}}>Spell DC</option>
                                <option value="class" {{#if isClassDC}}selected{{/if}}>Class DC</option>
                                <option value="custom" {{#if isCustomDC}}selected{{/if}}>Custom Number</option>
                            </select>
                            <input type="number" name="flags.aoe-easy-resolve.saveDC" value="{{saveDC}}" placeholder="e.g. 20" style="flex: 1; text-align: center; padding: 4px;" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- STEP 3 -->
            <div class="wizard-step" data-step="3" style="display: none;">
                <h3 class="aer-step-header">{{localize "AOE.Config.Step3Title"}}</h3>
                <p class="aer-notes">{{localize "AOE.Config.Step3Notes"}}</p>
                
                <div class="form-group" style="margin-top: 15px; align-items: center;">
                    <label style="font-weight: bold; flex: 0 0 200px;">{{localize "AOE.Config.ApplyEffects"}}</label>
                    <div class="form-fields">
                        <input type="checkbox" name="flags.aoe-easy-resolve.useWizardEffects" {{checked useWizardEffects}} style="width: 20px; height: 20px;">
                    </div>
                </div>

                <div class="wizard-effects-settings aer-sub-settings" style="display: {{#if useWizardEffects}}block{{else}}none{{/if}};">
                    <div style="display: flex; gap: 8px; font-size: 0.8em; font-weight: bold; color: var(--aer-text-muted); margin-bottom: 4px; padding-right: 28px;">
                        <span style="flex: 0 0 120px;">Trigger</span>
                        <span style="width: 15px;"></span>
                        <span style="flex: 2;">Condition</span>
                        <span style="flex: 0 0 40px; text-align: center;">Val</span>
                        <span style="flex: 0 0 50px; text-align: center;">Rounds</span>
                    </div>

                    {{#each mappedWizardEffects as |effect|}}
                    <div style="display: flex; gap: 8px; align-items: center; margin-bottom: 8px;">
                        <select name="flags.aoe-easy-resolve.wizardEffects.{{effect.index}}.outcome" style="flex: 0 0 120px;">
                            <option value="criticalFailure" {{effect.selCF}}>Crit Fail</option>
                            <option value="failOrWorse" {{effect.selFailOrWorse}}>Fail or Worse</option>
                            <option value="failure" {{effect.selF}}>Failure</option>
                            <option value="success" {{effect.selS}}>Success</option>
                            <option value="successOrBetter" {{effect.selSuccessOrBetter}}>Success or Better</option>
                            <option value="criticalSuccess" {{effect.selCS}}>Crit Success</option>
                            <option value="always" {{effect.selAlways}}>Always</option>
                        </select>
                        <span style="font-weight:bold; color: #777;">&rarr;</span>
                        <select name="flags.aoe-easy-resolve.wizardEffects.{{effect.index}}.slug" style="flex: 2;">
                            {{#each effect.conditionOptions}}
                            <option value="{{this.key}}" {{this.selected}}>{{this.label}}</option>
                            {{/each}}
                        </select>
                        <input type="number" name="flags.aoe-easy-resolve.wizardEffects.{{effect.index}}.value" value="{{effect.value}}" placeholder="Val" style="flex: 0 0 40px; text-align: center;">
                        <input type="number" name="flags.aoe-easy-resolve.wizardEffects.{{effect.index}}.duration" value="{{effect.duration}}" placeholder="Rnds" style="flex: 0 0 50px; text-align: center;">
                        <a data-action="deleteWizardEffect" data-index="{{effect.index}}" style="color: var(--aer-danger); cursor: pointer; padding: 4px;"><i class="fas fa-times"></i></a>
                    </div>
                    {{/each}}
                    <button type="button" data-action="addWizardEffect" style="margin-top: 10px; background: var(--aer-bg-faint); border: 1px dashed var(--aer-border);"><i class="fas fa-plus"></i> {{localize "AOE.Config.AddEffect"}}</button>
                </div>
                
                <div class="aer-info-box">
                    <p style="margin: 0; font-size: 0.9em;"><strong>{{localize "AOE.Config.EffectNote"}}</strong></p>
                </div>
            </div>

            <!-- STEP 4 -->
            <div class="wizard-step" data-step="4" style="display: none;">
                <h3 class="aer-step-header">{{localize "AOE.Config.Step4Title"}}</h3>
                <p class="aer-notes">{{localize "AOE.Config.Step4Notes"}}</p>

                <div class="form-group" style="margin-top: 15px; align-items: center;">
                    <label style="font-weight: bold; flex: 0 0 200px;">{{localize "AOE.Config.ConfigInitDamage"}}</label>
                    <div class="form-fields">
                        <input type="checkbox" name="flags.aoe-easy-resolve.useCustomDamage" {{checked useCustomDamage}} style="width: 20px; height: 20px;">
                    </div>
                </div>

                <div class="wizard-damage-settings aer-sub-settings" style="display: {{#if useCustomDamage}}block{{else}}none{{/if}};">
                    <div style="display: flex; gap: 15px; margin-bottom: 15px; border-bottom: 1px dashed rgba(0,0,0,0.1); padding-bottom: 10px;">
                        <label style="display: flex; align-items: center; gap: 5px; cursor: pointer; font-weight: bold;">
                            <input type="checkbox" name="flags.aoe-easy-resolve.isBasicSave" {{checked isBasicSave}}> {{localize "AOE.Config.BasicSave"}}
                        </label>
                        <label style="display: flex; align-items: center; gap: 5px; cursor: pointer; font-weight: bold;">
                            <input type="checkbox" name="flags.aoe-easy-resolve.isAreaDamage" {{checked isAreaDamage}}> {{localize "AOE.Config.AreaDamage"}}
                        </label>
                    </div>

                    <p class="aer-notes" style="margin-bottom: 10px; font-weight: bold; color: var(--color-text-dark-primary);">{{localize "AOE.Config.DamageDice"}}</p>

                    {{#each mappedDamageParts as |part|}}
                    <div style="display: flex; gap: 8px; align-items: center; margin-bottom: 8px;">
                        <input type="number" name="flags.aoe-easy-resolve.damageParts.{{part.index}}.dice" value="{{part.dice}}" placeholder="#" style="flex: 0 0 50px; text-align: center;">
                        <select name="flags.aoe-easy-resolve.damageParts.{{part.index}}.die" style="flex: 0 0 60px;">
                            {{#each part.dieOptions}}
                            <option value="{{this.value}}" {{this.selected}}>{{this.value}}</option>
                            {{/each}}
                        </select>
                        <select name="flags.aoe-easy-resolve.damageParts.{{part.index}}.type" style="flex: 2;">
                            {{#each part.typeOptions}}
                            <option value="{{this.key}}" {{this.selected}}>{{this.label}}</option>
                            {{/each}}
                        </select>
                        {{#if part.index}}
                            <a data-action="deleteDamagePart" data-index="{{part.index}}" style="color: var(--aer-danger); cursor: pointer; padding: 4px;"><i class="fas fa-times"></i></a>
                        {{/if}}
                    </div>
                    {{/each}}
                    
                    <button type="button" data-action="addDamagePart" style="margin-top: 10px; background: var(--aer-bg-faint); border: 1px dashed var(--aer-border);"><i class="fas fa-plus"></i> {{localize "AOE.Config.AddDamage"}}</button>
                </div>
            </div>

            <!-- STEP 5 -->
            <div class="wizard-step" data-step="5" style="display: none;">
                <h3 class="aer-step-header">{{localize "AOE.Config.Step5Title"}}</h3>
                <p class="aer-notes">{{localize "AOE.Config.Step5Notes"}}</p>

                <div style="display: flex; gap: 15px; margin-top: 15px;">
                    <label class="aer-radio-box" style="flex: 1; justify-content: center;">
                        <input type="radio" name="wizardPersist" value="no" {{#unless hazardDuration}}checked{{/unless}}> {{localize "AOE.Config.PersistNo"}}
                    </label>
                    <label class="aer-radio-box" style="flex: 1; justify-content: center;">
                        <input type="radio" name="wizardPersist" value="yes" {{#if hazardDuration}}checked{{/if}}> {{localize "AOE.Config.PersistYes"}}
                    </label>
                </div>

                <div class="wizard-persist-settings aer-sub-settings" style="display: {{#if hazardDuration}}block{{else}}none{{/if}}; border-left-color: var(--aer-accent-purple);">
                    <div class="form-group">
                        <label>{{localize "AOE.Config.DurationLabel"}}</label>
                        <div class="form-fields">
                            <input type="number" name="flags.aoe-easy-resolve.hazardDuration" value="{{hazardDuration}}" />
                        </div>
                        <p class="aer-notes">{{localize "AOE.Config.DurationNotes"}}</p>
                    </div>
                </div>
            </div>

            <!-- STEP 6 -->
            <div class="wizard-step" data-step="6" style="display: none;">
                <h3 class="aer-step-header">{{localize "AOE.Config.Step6Title"}}</h3>
                <p class="aer-notes">{{localize "AOE.Config.Step6Notes"}}</p>

                <div class="form-group" style="margin-top: 15px;">
                    <label>{{localize "AOE.Config.TerrainEffect"}}</label>
                    <div class="form-fields">
                        <select name="flags.aoe-easy-resolve.terrainEffect" style="flex: 1;">
                            <option value="none" {{#if terrainNone}}selected{{/if}}>None (Normal Terrain)</option>
                            <option value="difficult" {{#if terrainDifficult}}selected{{/if}}>Difficult Terrain (+1 Cost)</option>
                            <option value="greater" {{#if terrainGreater}}selected{{/if}}>Greater Difficult (+2 Cost)</option>
                        </select>
                    </div>
                </div>

                <div class="aer-danger-box">
                    <p style="margin: 0; font-size: 0.9em;"><strong>{{localize "AOE.Config.AdvancedWarning"}}</strong></p>
                </div>
            </div>

        </div>

        <div style="display: flex; justify-content: space-between; margin-top: 15px;">
            <button type="button" class="wizard-prev" style="width: auto; padding: 0 15px; display: none;"><i class="fas fa-arrow-left"></i> Back</button>
            <div style="flex: 1;"></div>
            <button type="button" class="wizard-next" style="width: auto; padding: 0 15px;"><i class="fas fa-arrow-right"></i> Next</button>
            <button type="submit" class="wizard-save" style="width: auto; padding: 0 15px; display: none; background: var(--aer-accent-purple); color: white; border: none;"><i class="fas fa-save"></i> {{localize "AOE.Config.SaveBtn"}}</button>
        </div>
    </div>
    {{else}}
        <nav class="aer-app-nav sheet-tabs">
            <a class="item" data-tab="blast"><i class="fas fa-fire"></i> {{localize "AOE.Config.TabBlast"}}</a>
            <a class="item" data-tab="zone"><i class="fas fa-map"></i> {{localize "AOE.Config.TabZone"}}</a>
            <a class="item" data-tab="rules"><i class="fas fa-clipboard-list"></i> {{localize "AOE.Config.TabRules"}}</a>
        </nav>

        <section class="aer-tab-content" style="height: calc(100% - 100px); overflow-y: auto;">
            
            <!-- TAB 1: BLAST & MATH -->
            <div class="tab" data-tab="blast">
                <div class="form-group" style="align-items: center;">
                <label style="font-weight: bold; flex: 0 0 160px;">Override System Save?</label>
                <div class="form-fields" style="display: flex; align-items: center; gap: 15px;">
                    <input type="checkbox" name="flags.aoe-easy-resolve.useOverride" {{checked useOverride}}>
                    <label style="display: flex; align-items: center; gap: 4px; cursor: pointer; font-size: 0.9em; border-left: 1px solid var(--aer-border); padding-left: 15px;">
                        <input type="checkbox" name="flags.aoe-easy-resolve.isBasicSave" {{checked isBasicSave}}> Basic Save Math?
                    </label>
                </div>
            </div>
                <div class="form-group">
                    <label>Save Type</label>
                    <div class="form-fields">
                        <select name="flags.aoe-easy-resolve.saveType">
                            <option value="fortitude" {{#if isFort}}selected{{/if}}>Fortitude</option>
                            <option value="reflex" {{#if isReflex}}selected{{/if}}>Reflex</option>
                            <option value="will" {{#if isWill}}selected{{/if}}>Will</option>
                        </select>
                    </div>
                </div>
                <div class="form-group">
                    <label>Save DC Source</label>
                    <div class="form-fields">
                        <select name="flags.aoe-easy-resolve.dcType" style="flex: 1;">
                            <option value="custom" {{#if isCustomDC}}selected{{/if}}>Custom (Static Number)</option>
                            <option value="highest" {{#if isHighestDC}}selected{{/if}}>Highest (Class or Spell)</option>
                            <option value="class" {{#if isClassDC}}selected{{/if}}>Highest Class DC</option>
                            <option value="spell" {{#if isSpellDC}}selected{{/if}}>Highest Spell DC</option>
                        </select>
                        <input type="number" name="flags.aoe-easy-resolve.saveDC" value="{{saveDC}}" placeholder="e.g. 20" style="flex: 0 0 60px; text-align: center;" />
                    </div>
                </div>

                <hr style="margin: 15px 0;">
                <p class="aer-notes" style="font-weight: bold;">Geometry & Targeting</p>

                <div class="form-group">
                    <label>Provide Custom Template?</label>
                    <div class="form-fields"><input type="checkbox" name="flags.aoe-easy-resolve.provideTemplate" {{checked provideTemplate}}></div>
                </div>
                {{#if provideTemplate}}
                <div class="form-group">
                    <label>Shape & Size</label>
                    <div class="form-fields">
                        <select name="flags.aoe-easy-resolve.templateType" style="width: 50%;">
                            <option value="cone" {{#if isCone}}selected{{/if}}>Cone</option>
                            <option value="circle" {{#if isCircle}}selected{{/if}}>Burst</option>
                            <option value="ray" {{#if isRay}}selected{{/if}}>Line</option>
                        </select>
                        <input type="number" name="flags.aoe-easy-resolve.templateDistance" value="{{templateDistance}}" placeholder="ft." style="width: 50%;">
                    </div>
                </div>
                {{/if}}

                <div class="form-group">
                    <label>Enable Multi-Target (No Template)?</label>
                    <div class="form-fields"><input type="checkbox" name="flags.aoe-easy-resolve.enableMultiTarget" {{checked enableMultiTarget}}></div>
                </div>
                <div class="form-group" style="align-items: center;">
                    <label style="font-weight: bold; flex: 0 0 200px;">Enable Tactical Drawing Tools?</label>
                    <div class="form-fields" style="display: flex; align-items: center; gap: 15px;">
                        <input type="checkbox" name="flags.aoe-easy-resolve.tacticalDrawing" {{checked tacticalDrawing}}>
                        <input type="number" name="flags.aoe-easy-resolve.tacticalBlocks" value="{{tacticalBlocks}}" placeholder="Max Squares (e.g. 4)" style="width: 150px; padding: 4px; text-align: center;">
                    </div>
                </div>

                <hr style="margin: 15px 0;">
                <p class="aer-notes" style="font-weight: bold;">Damage Overrides</p>

                <div class="form-group">
                    <label>Use Custom Damage Builder?</label>
                    <div class="form-fields"><input type="checkbox" name="flags.aoe-easy-resolve.useCustomDamage" {{checked useCustomDamage}}></div>
                </div>
                {{#if useCustomDamage}}
                <div class="form-group">
                    <label>Formula</label>
                    <div class="form-fields" style="display: flex; align-items: center; gap: 5px;">
                        <input type="text" name="flags.aoe-easy-resolve.baseDamage" value="{{baseDamage}}" placeholder="e.g. 2d6" style="flex: 2;" />
                        <span style="font-weight: bold; color: var(--aer-text-muted);">+</span>
                        <input type="text" name="flags.aoe-easy-resolve.scaleDamage" value="{{scaleDamage}}" placeholder="1d6" style="flex: 1;" />
                        <span style="font-weight: bold; color: var(--aer-text-muted);">per</span>
                        <select name="flags.aoe-easy-resolve.scaleMode" style="flex: 2;">
                            <option value="none" {{#if scaleNone}}selected{{/if}}>None</option>
                            <option value="spellRank" {{#if scaleSpellRank}}selected{{/if}}>Spell Rank (+1)</option>
                            <option value="cantrip" {{#if scaleCantrip}}selected{{/if}}>Cantrip Rank (+1)</option>
                            <option value="actorLevel" {{#if scaleActorLevel}}selected{{/if}}>Actor Level (+1)</option>
                        </select>
                    </div>
                </div>
                {{/if}}
            </div>

            <!-- TAB 2: ENVIRONMENT & ZONE -->
            <div class="tab" data-tab="zone">
                <div class="form-group">
                    <label>Hazard Duration</label>
                    <div class="form-fields">
                        <input type="number" name="flags.aoe-easy-resolve.hazardDuration" value="{{hazardDuration}}" placeholder="e.g. 1 (Rounds)" />
                    </div>
                    <p class="aer-notes">Leave blank for infinite. Swept automatically by the Janitor.</p>
                </div>

                <div class="form-group">
                    <label>Terrain Effects</label>
                    <div class="form-fields">
                        <select name="flags.aoe-easy-resolve.terrainEffect" style="flex: 1;">
                            <option value="none" {{#if terrainNone}}selected{{/if}}>Normal Terrain</option>
                            <option value="difficult" {{#if terrainDifficult}}selected{{/if}}>Difficult Terrain (+1 Cost)</option>
                            <option value="greater" {{#if terrainGreater}}selected{{/if}}>Greater Difficult Terrain (+2 Cost)</option>
                        </select>
                    </div>
                </div>

                <hr style="margin: 15px 0;">
                <p class="aer-notes" style="font-weight: bold;">Alliance Matrix</p>

                <div class="form-group">
                    <label>Enemy Base Effect</label>
                    <div class="form-fields">
                        <select name="flags.aoe-easy-resolve.enemyBaseEffect">
                            <option value="standard" {{#if enemyBaseStandard}}selected{{/if}}>Standard (Take Damage)</option>
                            <option value="heal" {{#if enemyBaseHeal}}selected{{/if}}>Healing (Restore HP)</option>
                            <option value="immune" {{#if enemyBaseImmune}}selected{{/if}}>Immune (Ignore Roll)</option>
                        </select>
                    </div>
                </div>
                <div class="form-group">
                    <label>Ally Base Effect</label>
                    <div class="form-fields">
                        <select name="flags.aoe-easy-resolve.allyBaseEffect">
                            <option value="standard" {{#if allyBaseStandard}}selected{{/if}}>Standard (Take Damage)</option>
                            <option value="heal" {{#if allyBaseHeal}}selected{{/if}}>Healing (Restore HP)</option>
                            <option value="immune" {{#if allyBaseImmune}}selected{{/if}}>Immune (Ignore Roll)</option>
                        </select>
                    </div>
                </div>
                <div class="form-group">
                    <label>Is Area Damage?</label>
                    <div class="form-fields">
                        <input type="checkbox" name="flags.aoe-easy-resolve.isAreaDamage" {{checked isAreaDamage}}>
                    </div>
                    <p class="aer-notes">Forces the 'area-effect' and 'damaging-effect' traits to trigger Swarm weaknesses.</p>
                </div>
            </div>

            <!-- TAB 3: RULES ENGINE -->
            <div class="tab" data-tab="rules">
                <p class="aer-notes" style="margin-bottom: 10px;">Define specific triggers based on roll outcomes and target traits.</p>
                
                {{#each processedRules as |rule|}}
                <div class="aer-rule-card">
                    <a data-action="deleteRule" data-index="{{rule.index}}" style="position: absolute; top: 5px; right: 8px; color: var(--aer-danger); cursor: pointer;" title="Delete Rule"><i class="fas fa-trash"></i></a>
                    
                    <div class="form-group">
                        <label>Trigger</label>
                        <div class="form-fields">
                            <select name="flags.aoe-easy-resolve.rules.{{rule.index}}.context">
                                <option value="attack" {{#if rule.isAttack}}selected{{/if}}>Attack Roll</option>
                                <option value="save" {{#if rule.isSave}}selected{{/if}}>Save Result</option>
                                <option value="reactiveSave" {{#if rule.isReactiveSave}}selected{{/if}}>Reactive Save (Hazard)</option>
                                <option value="tokenEnter" {{#if rule.isTokenEnter}}selected{{/if}}>Token Enters Region</option>
                                <option value="tokenExit" {{#if rule.isTokenExit}}selected{{/if}}>Token Exits Region</option>
                                <option value="tokenMove" {{#if rule.isTokenMove}}selected{{/if}}>Moves Within Region</option>
                                <option value="turnStart" {{#if rule.isTurnStart}}selected{{/if}}>Start of Turn</option>
                                <option value="turnEnd" {{#if rule.isTurnEnd}}selected{{/if}}>End of Turn</option>
                            </select>
                            <select name="flags.aoe-easy-resolve.rules.{{rule.index}}.outcome">
                                <option value="always" {{#if rule.isAlways}}selected{{/if}}>Always (Passive / Enter)</option>
                                <option value="criticalSuccess" {{#if rule.isCS}}selected{{/if}}>Crit / Crit Success</option>
                                <option value="success" {{#if rule.isS}}selected{{/if}}>Hit / Success</option>
                                <option value="successOrBetter" {{#if rule.isSuccessOrBetter}}selected{{/if}}>Success or Better</option>
                                <option value="failure" {{#if rule.isF}}selected{{/if}}>Miss / Failure</option>
                                <option value="failOrWorse" {{#if rule.isFailOrWorse}}selected{{/if}}>Failure or Worse</option>
                                <option value="criticalFailure" {{#if rule.isCF}}selected{{/if}}>Crit Miss / Crit Fail</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Target Scope</label>
                        <div class="form-fields">
                            <select name="flags.aoe-easy-resolve.rules.{{rule.index}}.alliance">
                                <option value="all" {{#if rule.isAllianceAll}}selected{{/if}}>Affects Everyone</option>
                                <option value="enemy" {{#if rule.isAllianceEnemy}}selected{{/if}}>Enemies Only</option>
                                <option value="ally" {{#if rule.isAllianceAlly}}selected{{/if}}>Allies Only</option>
                            </select>
                        </div>
                    </div>
                    
                    <div class="form-group">
                        <label>Target Trait Requirement</label>
                        <div class="form-fields">
                            <input type="text" name="flags.aoe-easy-resolve.rules.{{rule.index}}.trait" value="{{rule.trait}}" placeholder="e.g. plant (leave blank)">
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Condition UUID</label>
                        <div class="form-fields">
                            <input type="text" name="flags.aoe-easy-resolve.rules.{{rule.index}}.conditionUuid" value="{{rule.conditionUuid}}" placeholder="Compendium.pf2e...">
                        </div>
                    </div>

                    <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 5px;">
                        <label style="display: flex; align-items: center; gap: 4px; font-size: 0.9em;">
                            <input type="checkbox" name="flags.aoe-easy-resolve.rules.{{rule.index}}.removeOnExit" {{checked rule.removeOnExit}}> Remove on Exit
                        </label>
                        <label style="display: flex; align-items: center; gap: 4px; font-size: 0.9em;">
                            <input type="checkbox" name="flags.aoe-easy-resolve.rules.{{rule.index}}.promptSave" {{#if rule.promptSave}}checked{{/if}}> Prompt Reactive Save?
                        </label>
                    </div>

                    <div class="form-group" style="margin-top: 10px;">
                        <label>Bonus Damage</label>
                        <div class="form-fields">
                            <input type="text" name="flags.aoe-easy-resolve.rules.{{rule.index}}.damageFormula" value="{{rule.damageFormula}}" placeholder="e.g. 1d6" style="width: 50%;">
                            <select name="flags.aoe-easy-resolve.rules.{{rule.index}}.damageType" style="width: 50%;">
                                {{#each rule.damageTypeOptions}}
                                <option value="{{this.key}}" {{this.selected}}>{{this.label}}</option>
                                {{/each}}
                            </select>
                        </div>
                    </div>
                </div>
                {{/each}}

                <button type="button" data-action="addRule" style="margin-top: 5px;"><i class="fas fa-plus"></i> Add New Rule</button>
            </div>
        </section>

        <footer style="margin-top: 15px; border-top: 1px solid var(--aer-border); padding-top: 10px; text-align: right;">
            <button type="submit" style="width: auto; padding: 0 15px;"><i class="fas fa-save"></i> {{localize "AOE.Config.SaveBtn"}}</button>
        </footer>
    {{/if}}
</div>